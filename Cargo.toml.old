[package]
name = "nu_plugin_graphrag"
version = "0.1.0"
edition = "2024"
description = "Nushell plugin for GraphRAG - knowledge graph + HNSW vector search"
license = "MIT"

[[bin]]
name = "nu_plugin_graphrag"
path = "src/main.rs"

[dependencies]
nu-plugin = "0.109"
nu-protocol = "0.109"
rusqlite = { version = "0.32", features = ["bundled"] }
usearch = "2.15"
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
thiserror = "2.0"
dirs = "5.0"

[profile.release]
opt-level = 3
lto = true
